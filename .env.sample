DISCORD_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE
AUTO_DISCONNECT_SECONDS=180

# Optional: set a Guild ID to sync commands ONLY in that server (fast propagation).
# If unset, commands sync globally (can take up to ~1 hour to propagate).
# SYNC_GUILD_ID=123456789012345678

# Optional: YouTube cookies path for yt-dlp (can improve restricted/private streams)
# YTDLP_COOKIES=/absolute/path/to/cookies.txt
